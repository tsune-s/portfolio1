# Environment Variables Example
# Copy this file to .env and fill in your values

# Database Configuration (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys (if needed)
# API_KEY=your_api_key_here

# Model Configuration
RANDOM_STATE=42
TEST_SIZE=0.2

# Paths
DATA_DIR=./data
MODELS_DIR=./models
